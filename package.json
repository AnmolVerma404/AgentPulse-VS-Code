{
  "name": "agentpulse-vscode",
  "displayName": "AgentPulse - AI Chat Companion",
  "description": "Monitor, approve, and steer Google Antigravity & Copilot sessions remotely from your mobile phone.",
  "version": "0.1.0",
  "publisher": "agentpulse",
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:agentpulse.controlView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentpulse-explorer",
          "title": "AgentPulse",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agentpulse-explorer": [
        {
          "type": "webview",
          "id": "agentpulse.controlView",
          "name": "Control Center"
        }
      ]
    },
    "commands": [
      {
        "command": "agentpulse.startServer",
        "title": "AgentPulse: Start Mobile Companion Server"
      },
      {
        "command": "agentpulse.showPairingQr",
        "title": "AgentPulse: Show Mobile Pairing QR Code"
      },
      {
        "command": "agentpulse.stopServer",
        "title": "AgentPulse: Stop Server"
      }
    ],
    "configuration": {
      "title": "AgentPulse",
      "properties": {
        "agentpulse.port": {
          "type": "number",
          "default": 49152,
          "description": "Port for local AgentPulse WebSocket server"
        },
        "agentpulse.autoKeepAwake": {
          "type": "boolean",
          "default": true,
          "description": "Prevent computer from sleeping while an AI agent task is running"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package --allow-missing-repository",
    "test": "jest",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "@types/qrcode": "^1.5.6",
    "@types/vscode": "^1.93.0",
    "@types/ws": "^8.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  }
}
